목록 리팩터링은 500줄을 줄이는 일이 아니었습니다"}}},{"node":{"id":"5411d803-4f20-5356-b329-a7af462f5a52","fields":{"slug":"/frontend/e-commerce/headless-select-compound-dialog/"},"frontmatter":{"title":"셀렉트를 세 벌 그렸지만 로직은 한 벌만 짰습니다"}}},{"node":{"id":"573d0631-0521-5556-aec8-91efe39ed5a7","fields":{"slug":"/frontend/e-commerce/state-ownership-first/"},"frontmatter":{"title":"상태 관리보다 먼저 정한 네 가지 불변식"}}}]},"previous":{"fields":{"slug":"/frontend/good-code-and-ai/"},"frontmatter":{"title":"돌아가는 코드와 좋은 코드, 그리고 AI를 어디까지 믿을까"}},"next":{"fields":{"slug":"/frontend/e-commerce/product-list-boundary/"},"frontmatter":{"title":"상품 목록 리팩터링은 500줄을 줄이는 일이 아니었습니다"}}},"pageContext":{"id":"9b16f479-7066-58d6-b436-bc06a6a77b6d","series":null,"seriesNav":false,"previousPostId":"ee27949e-fa0a-5d11-ad73-4dfe0463d7cc","nextPostId":"e5cdea4b-42c7-585a-a06f-8c082abd781d"}},"staticQueryHashes":[],"slicesMap":{}}