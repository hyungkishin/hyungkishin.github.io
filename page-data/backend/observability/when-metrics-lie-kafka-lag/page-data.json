ontmatter":{"title":"캐시 hit률 100%인데 왜 응답이 느렸을까"}}},{"node":{"id":"13a1d0a5-ca12-5301-884c-b53b6ce390a8","fields":{"slug":"/backend/spring/task-rejection-and-virtual-threads/"},"frontmatter":{"title":"5,235건이 사라진 자리, 코드 어느 줄에서 일어났을까요"}}},{"node":{"id":"ee27949e-fa0a-5d11-ad73-4dfe0463d7cc","fields":{"slug":"/frontend/good-code-and-ai/"},"frontmatter":{"title":"돌아가는 코드와 좋은 코드, 그리고 AI를 어디까지 믿을까"}}},{"node":{"id":"9b16f479-7066-58d6-b436-bc06a6a77b6d","fields":{"slug":"/frontend/e-commerce/checkout-modeling/"},"frontmatter":{"title":"체크아웃 리팩터링은 컴포넌트 분리가 아니라 금액 모델링부터였습니다"}}},{"node":{"id":"e5cdea4b-42c7-585a-a06f-8c082abd781d","fields":{"slug":"/frontend/e-commerce/product-list-boundary/"},"frontmatter":{"title":"상품 목록 리팩터링은 500줄을 줄이는 일이 아니었습니다"}}},{"node":{"id":"5411d803-4f20-5356-b329-a7af462f5a52","fields":{"slug":"/frontend/e-commerce/headless-select-compound-dialog/"},"frontmatter":{"title":"셀렉트를 세 벌 그렸지만 로직은 한 벌만 짰습니다"}}}]},"previous":{"fields":{"slug":"/backend/observability/when-metrics-lie-error-rate/"},"frontmatter":{"title":"계기가 거짓말할 때 ① 에러율 0%인데 181건이 실패했습니다"}},"next":{"fields":{"slug":"/backend/observability/when-metrics-lie-redis-p95/"},"frontmatter":{"title":"계기가 거짓말할 때 ③ Redis P95 5.68초는 어디서 잰 시간일까"}}},"pageContext":{"id":"85f42137-a6da-544e-b6e7-dbbae0aa17bb","previousPostId":"d3cff941-ec29-5e82-af55-b1ffba0789d5","nextPostId":"425c5fc7-da12-5756-a9ee-e2fc69bbe9e6"}},"staticQueryHashes":[],"slicesMap":{}}