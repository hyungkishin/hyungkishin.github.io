7-3000-554d-9ac0-236a1526d1cc","fields":{"slug":"/e-commerce/technical-writing/week6/"},"frontmatter":{"title":"PG 3초 딜레이로, 회사 문닫게 생겼어요"}}},{"node":{"id":"b6937be9-8747-5f66-a9c9-f1eec518c743","fields":{"slug":"/e-commerce/will/seven-week/"},"frontmatter":{"title":"한 가지를 해결하면 반드시 다른 문제가 따라온다"}}},{"node":{"id":"6386e462-f04f-5418-9148-94afe7fdf3df","fields":{"slug":"/e-commerce/technical-writing/week7/"},"frontmatter":{"title":"선착순 쿠폰 100장, 1만 명이 동시에 누르면?"}}},{"node":{"id":"3cadc0ff-0375-5276-9cc2-bbf75e48a891","fields":{"slug":"/books/tailer/"},"frontmatter":{"title":"과학적 관리법을 읽고"}}},{"node":{"id":"e0e3bf0d-13dc-5c86-8b2c-96833c2998d4","fields":{"slug":"/e-commerce/technical-writing/week8/"},"frontmatter":{"title":"주문 버튼 1만 번 눌리면, 대기열 없이 버틸 수 있을까?"}}},{"node":{"id":"73636a07-5aa4-55d2-b6e4-d570a01997af","fields":{"slug":"/e-commerce/technical-writing/week9/"},"frontmatter":{"title":"오늘의 인기상품, 어제의 인기상품과 어떻게 구분할까?"}}},{"node":{"id":"5e3dde0a-abcd-5515-aceb-787f2c62ff3e","fields":{"slug":"/e-commerce/will/will10/"},"frontmatter":{"title":"정상 흐름에서 안 보이는 것들"}}},{"node":{"id":"9dcf193c-e3bc-5cc7-8528-7528cf6063c4","fields":{"slug":"/e-commerce/technical-writing/week10/"},"frontmatter":{"title":"누적 데이터로 '이번 주 랭킹'을 만들 수 있을까?"}}},{"node":{"id":"1bc19e82-987c-5e76-a7ac-f3f2a266c542","fields":{"slug":"/company/"},"frontmatter":{"title":"회사 10주년, AI로 다시 보는 사업의 순간들"}}},{"node":{"id":"978ea57a-f03f-58bb-b7ae-db74b0c533d1","fields":{"slug":"/company/work/why6/"},"frontmatter":{"title":"큐 거부 0건을 성공이라고 부른 직후, Outbox까지 가야 했습니다"}}},{"node":{"id":"5cacd537-cd53-5d32-86b6-3163830df382","fields":{"slug":"/company/work/why5/"},"frontmatter":{"title":"첫 호출만 5초, warmup으로 풀릴 줄 알았어요"}}},{"node":{"id":"1d1eeb62-a650-5cf5-b7a6-adb3683adbb7","fields":{"slug":"/company/work/why4/"},"frontmatter":{"title":"8h 안에 한 번에 끝낸다는 SLA 가정 때문에 같은 사용자가 계속 누락됐어요"}}},{"node":{"id":"7cf7c6c4-d8d7-5707-b27b-0e736cffed34","fields":{"slug":"/company/work/why3/"},"frontmatter":{"title":"에러 메시지가 결함을 다시 트리거하는 루프"}}},{"node":{"id":"5c4253f9-2584-56b1-ab3b-5910dd7ae355","fields":{"slug":"/company/work/why2/"},"frontmatter":{"title":"같은 버그가 두 종류 알림으로 보였습니다"}}},{"node":{"id":"6f0e0a20-a1d9-5af9-b884-3eb7ad1b3ca6","fields":{"slug":"/company/work/why1/"},"frontmatter":{"title":"캐시 hit률 100%인데 왜 응답이 느렸을까"}}},{"node":{"id":"13a1d0a5-ca12-5301-884c-b53b6ce390a8","fields":{"slug":"/backend/spring/task-rejection-and-virtual-threads/"},"frontmatter":{"title":"5,235건이 사라진 자리, 코드 어느 줄에서 일어났을까요"}}},{"node":{"id":"ee27949e-fa0a-5d11-ad73-4dfe0463d7cc","fields":{"slug":"/frontend/good-code-and-ai/"},"frontmatter":{"title":"돌아가는 코드와 좋은 코드, 그리고 AI를 어디까지 믿을까"}}},{"node":{"id":"9b16f479-7066-58d6-b436-bc06a6a77b6d","fields":{"slug":"/frontend/e-commerce/checkout-modeling/"},"frontmatter":{"title":"체크아웃 리팩터링은 컴포넌트 분리가 아니라 금액 모델링부터였습니다"}}},{"node":{"id":"e5cdea4b-42c7-585a-a06f-8c082abd781d","fields":{"slug":"/frontend/e-commerce/product-list-boundary/"},"frontmatter":{"title":"상품 목록 리팩터링은 500줄을 줄이는 일이 아니었습니다"}}},{"node":{"id":"5411d803-4f20-5356-b329-a7af462f5a52","fields":{"slug":"/frontend/e-commerce/headless-select-compound-dialog/"},"frontmatter":{"title":"셀렉트를 세 벌 그렸지만 로직은 한 벌만 짰습니다"}}}]},"previous":{"fields":{"slug":"/backend/observability/when-metrics-lie/"},"frontmatter":{"title":"계기가 거짓말할 때 : 대시보드는 왜 거짓말할까"}},"next":{"fields":{"slug":"/backend/observability/when-metrics-lie-kafka-lag/"},"frontmatter":{"title":"계기가 거짓말할 때 : Kafka lag 0은 무엇을 의미할까"}}},"pageContext":{"id":"d3cff941-ec29-5e82-af55-b1ffba0789d5","previousPostId":"717c0f44-1343-5d96-9321-8426334e6336","nextPostId":"85f42137-a6da-544e-b6e7-dbbae0aa17bb"}},"staticQueryHashes":[],"slicesMap":{}}