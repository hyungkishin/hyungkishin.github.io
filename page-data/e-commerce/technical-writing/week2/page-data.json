a-5d11-ad73-4dfe0463d7cc","fields":{"slug":"/frontend/good-code-and-ai/"},"frontmatter":{"title":"돌아가는 코드와 좋은 코드, 그리고 AI를 어디까지 믿을까"}}},{"node":{"id":"9b16f479-7066-58d6-b436-bc06a6a77b6d","fields":{"slug":"/frontend/e-commerce/checkout-modeling/"},"frontmatter":{"title":"체크아웃 리팩터링은 컴포넌트 분리가 아니라 금액 모델링부터였습니다"}}},{"node":{"id":"e5cdea4b-42c7-585a-a06f-8c082abd781d","fields":{"slug":"/frontend/e-commerce/product-list-boundary/"},"frontmatter":{"title":"상품 목록 리팩터링은 500줄을 줄이는 일이 아니었습니다"}}},{"node":{"id":"5411d803-4f20-5356-b329-a7af462f5a52","fields":{"slug":"/frontend/e-commerce/headless-select-compound-dialog/"},"frontmatter":{"title":"셀렉트를 세 벌 그렸지만 로직은 한 벌만 짰습니다"}}},{"node":{"id":"573d0631-0521-5556-aec8-91efe39ed5a7","fields":{"slug":"/frontend/e-commerce/state-ownership-first/"},"frontmatter":{"title":"상태 관리보다 먼저 정한 네 가지 불변식"}}}]},"previous":{"fields":{"slug":"/e-commerce/will/two-week/"},"frontmatter":{"title":"요구사항을 설계로 번역하는 과정에서 내린 선택들"}},"next":{"fields":{"slug":"/backend/observability/reading-metrics/"},"frontmatter":{"title":"이 글은 '계기가 거짓말할 때' 시리즈로 옮겼습니다"}}},"pageContext":{"id":"eb7eb550-b43c-52e4-a564-f39aeff89eaa","series":null,"seriesNav":false,"previousPostId":"2442cae7-7c2c-5691-a6e7-825a91d3f1c6","nextPostId":"6ffd2ae8-75de-5c6e-be8e-56a811542cce"}},"staticQueryHashes":[],"slicesMap":{}}